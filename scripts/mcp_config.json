{
  "airbnb": {
    "command": "npx",
    "args": [
      "-y",
      "@openbnb/mcp-server-airbnb",
      "--ignore-robots-txt"
    ],
    "transport": "stdio"
  },
  "google-calendar": {
    "command": "npx",
    "args": [
      "-y",
      "@cocal/google-calendar-mcp"
    ],
    "env": {
      "GOOGLE_OAUTH_CREDENTIALS": "${GOOGLE_OAUTH_CREDENTIALS}",
      "GOOGLE_CALENDAR_MCP_TOKEN_PATH": "${GOOGLE_CALENDAR_MCP_TOKEN_PATH}"
    },
    "transport": "stdio"
  }
}
